rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "alexisguerra9577@gmail.com" ||
        request.auth.token.email == "alexis.guerra@orimec.com.ec" ||
        (exists(/databases/(default)/documents/users/$(request.auth.uid)) && 
         get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- COLLECTION MATCHES ---

    // 2. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
    }

    // User Private Split Collection
    match /users/{userId}/private/info {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Matches
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Forecasts (Seguro y simplificado para evitar errores de tipo y tiempo de sincronización)
    match /forecasts/{forecastId} {
      allow read: if isSignedIn();
      
      allow create, update: if isSignedIn() && 
                    isValidId(forecastId) &&
                    (isAdmin() || (
                      incoming().userId == request.auth.uid &&
                      (
                        forecastId == (incoming().matchId + "_" + request.auth.uid) ||
                        (incoming().keys().hasAll(['leagueCode']) && forecastId == (incoming().matchId + "_" + request.auth.uid + "_" + incoming().leagueCode))
                      ) && 
                      // Valida que los goles existan y sean numéricos
                      incoming().homeScore >= 0 && incoming().homeScore <= 99 &&
                      incoming().awayScore >= 0 && incoming().awayScore <= 99 &&
                      // Verifica que el partido exista en la base de datos
                      exists(/databases/(default)/documents/matches/$(incoming().matchId)) &&
                      // Verifica que el partido esté programado y en el futuro
                      get(/databases/(default)/documents/matches/$(incoming().matchId)).data.status == "scheduled" &&
                      request.time < timestamp(get(/databases/(default)/documents/matches/$(incoming().matchId)).data.dateTime)
                    ));

      allow delete: if isSignedIn() && (
                    isAdmin() || (
                      existing().userId == request.auth.uid &&
                      get(/databases/(default)/documents/matches/$(existing().matchId)).data.status == "scheduled" &&
                      request.time < timestamp(get(/databases/(default)/documents/matches/$(existing().matchId)).data.dateTime)
                    ));
    }

    // 5. Leagues
    match /leagues/{leagueCode} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isAdmin() || incoming().creatorId == request.auth.uid);
      allow delete: if isSignedIn() && (isAdmin() || existing().creatorId == request.auth.uid);

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && memberId == request.auth.uid && exists(/databases/(default)/documents/leagues/$(leagueCode));
        allow delete: if isSignedIn() && (
                      memberId == request.auth.uid || 
                      get(/databases/(default)/documents/leagues/$(leagueCode)).data.creatorId == request.auth.uid || 
                      isAdmin()
                      );
      }
    }

  }
}
